FROM php:8.3-cli-alpine

RUN apk add --no-cache \
    postgresql-dev \
    libzip-dev \
    zip \
    unzip \
    git \
    && docker-php-ext-install pdo pdo_pgsql zip bcmath

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY . .

RUN composer install --no-dev --optimize-autoloader --no-interaction \
    && php artisan storage:link

EXPOSE 8080

# Usa $PORT quando a plataforma injeta essa variável (Render); cai para 8080
# quando não injeta (App Runner, onde a porta é fixada nas configurações do
# serviço) — mesmo Dockerfile serve os dois sem duplicar arquivo.
CMD php artisan migrate --force && php artisan serve --host 0.0.0.0 --port ${PORT:-8080}
